{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "win",
      "displayName": "Windows x64 (MSVC 2022)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win-clang",
      "displayName": "Windows x64 (LLVM-MinGW clang, no admin / no MSVC required)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win-ninja",
      "displayName": "Windows x64 (Ninja, run from Developer PowerShell)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux clang (core + tests only; proves core has no Win32 dependency)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux clang + ASan/UBSan",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-debug",        "configurePreset": "win",         "configuration": "Debug" },
    { "name": "win-release",      "configurePreset": "win",         "configuration": "Release" },
    { "name": "win-clang-debug",  "configurePreset": "win-clang",   "configuration": "Debug" },
    { "name": "win-clang-release","configurePreset": "win-clang",   "configuration": "Release" },
    { "name": "linux-debug", "configurePreset": "linux-clang", "configuration": "Debug" },
    { "name": "linux-asan",  "configurePreset": "linux-asan",  "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "win-clang-debug",
      "configurePreset": "win-clang",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
